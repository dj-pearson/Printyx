# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/printyx

# App Configuration
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# OAuth Configuration - Google Calendar
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google-calendar/callback

# OAuth Configuration - Microsoft Calendar
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/integrations/microsoft-calendar/callback

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Storage Configuration (if using file uploads)
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads

# Additional Integration Settings
WEBHOOK_BASE_URL=http://localhost:5000/api/webhooks
INTEGRATION_SYNC_INTERVAL=300000

# SEO Management Configuration
# Required: Google PageSpeed Insights API (FREE)
PAGESPEED_INSIGHTS_API_KEY=your_pagespeed_api_key_here

# Optional: Google Search Console API (FREE)
GOOGLE_SEO_CLIENT_ID=your_google_seo_client_id_here
GOOGLE_SEO_CLIENT_SECRET=your_google_seo_client_secret_here
GOOGLE_SEO_REDIRECT_URI=http://localhost:5000/api/seo/gsc-oauth/callback

# Optional: Backlink APIs (choose one)
AHREFS_API_KEY=your_ahrefs_api_key_here
MOZ_ACCESS_ID=your_moz_access_id_here
MOZ_SECRET_KEY=your_moz_secret_key_here

# Optional: SERP Tracking (choose one)
SERPAPI_KEY=your_serpapi_key_here
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# Optional: Email Notifications for SEO Alerts
SEO_EMAIL_PROVIDER=console
SEO_RESEND_API_KEY=your_resend_api_key_here
SEO_EMAIL_FROM=noreply@yourdomain.com