# Generated report files at the repo root (report.json, report-2026-…).
# Anchored with a leading slash: a bare "report*" also matches any nested
# path segment, which silently swallowed scripts/audit/lib/report-generator.ts
# and required the 21 negation lines that used to live here.
/report*

# Playwright output at the repo root. playwright.config.ts writes
# test-results/{results.json,junit.xml} plus the html reporter's
# playwright-report/. Only "testing/test-results/" was ignored, so the ROOT
# copies were untracked — invisible until PROD-002, because the e2e suite was
# collecting 0 tests and never produced any output to leave behind.
# Anchored per the note above so these never match a nested source path.
/playwright-report/
/test-results/
Output.json
.env.tmp

# Database table dumps — never commit (may contain customer PII). PA-011.
*_rows.csv
*_rows.sql

# Repo hygiene — design sources, temp/debug files, Office lock files (PA-051).
# Design binaries belong in asset storage / Git LFS, not the app repo.
*.psd
temp.txt
progress.txt
~$*

# Security hardening — merged from .gitignore.security-additions (PA-015).
# NOTE: deliberately NOT ignoring *.sql (would drop drizzle migrations) or
# .env.* (would drop the intentional .env.example / .env.development templates).
.env.local
.env.*.local
.env.production
.env.staging
*.env
.env.save
*.env.backup
*.env.bak
