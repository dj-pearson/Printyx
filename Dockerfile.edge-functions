# Supabase Edge Functions Dockerfile
# Runs Deno runtime for Supabase Edge Functions

FROM denoland/deno:1.38.5

# Install curl and wget for healthcheck (required by Coolify).
# ca-certificates is required so curl has a trust store — the slim Deno base
# ships without it, which makes HTTPS fetches fail with curl error 77.
RUN apt-get update && apt-get install -y --no-install-recommends curl wget ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install the Infisical CLI from the official GitHub release (static binary).
# We deliberately AVOID the apt/cloudsmith repo (artifacts-cli.infisical.com): it is
# unreachable from this build host, which silently left the package missing and
# failed the build. Pinned + self-verifying — the final `infisical --version` makes
# the build fail loudly if the binary didn't land. Bump INFISICAL_VERSION to upgrade.
ARG INFISICAL_VERSION=0.43.90
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    curl -fsSL -o /tmp/infisical.tar.gz \
      "https://github.com/Infisical/cli/releases/download/v${INFISICAL_VERSION}/cli_${INFISICAL_VERSION}_linux_${arch}.tar.gz"; \
    tar -xzf /tmp/infisical.tar.gz -C /usr/local/bin infisical; \
    rm /tmp/infisical.tar.gz; \
    infisical --version

WORKDIR /app

# Copy edge functions
COPY supabase/functions ./functions

# Ship the Windows installer scripts so the monitoring-clients edge function
# can stream them as part of the bundled installer.zip download. Read at
# runtime from /app/printyx-client/scripts (override with PRINTYX_INSTALLER_DIR).
COPY printyx-client/scripts ./printyx-client/scripts

# Set environment variables (will be overridden by Coolify)
ENV SUPABASE_URL=""
ENV SUPABASE_ANON_KEY=""
ENV SUPABASE_SERVICE_ROLE_KEY=""

# Cache dependencies
RUN deno cache --reload functions/**/*.ts

# Expose port for Edge Functions (configurable via PORT env var).
# Coolify's healthcheck is pinned at localhost:8000, so default to 8000.
EXPOSE 8000

# Copy the start script (wraps the Deno server with Infisical secret injection)
COPY start-edge-functions.sh /app/start.sh
RUN chmod +x /app/start.sh

# Copy the server router (with CORS support) from the functions folder
RUN cp /app/functions/server.ts /app/server.ts

# Run the start script
CMD ["/app/start.sh"]

