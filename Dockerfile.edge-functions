# Supabase Edge Functions Dockerfile
# Runs Deno runtime for Supabase Edge Functions

FROM denoland/deno:1.38.5

# Install curl and wget for healthcheck (required by Coolify)
RUN apt-get update && apt-get install -y --no-install-recommends curl wget \
    && rm -rf /var/lib/apt/lists/*

# Install the Infisical CLI (used at startup to pull secrets from env.dpearsonmedia.com)
RUN curl -1sLf 'https://artifacts-cli.infisical.com/setup.deb.sh' | bash \
    && apt-get update && apt-get install -y --no-install-recommends infisical \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy edge functions
COPY supabase/functions ./functions

# Ship the Windows installer scripts so the monitoring-clients edge function
# can stream them as part of the bundled installer.zip download. Read at
# runtime from /app/printyx-client/scripts (override with PRINTYX_INSTALLER_DIR).
COPY printyx-client/scripts ./printyx-client/scripts

# Set environment variables (will be overridden by Coolify)
ENV SUPABASE_URL=""
ENV SUPABASE_ANON_KEY=""
ENV SUPABASE_SERVICE_ROLE_KEY=""

# Cache dependencies
RUN deno cache --reload functions/**/*.ts

# Expose port for Edge Functions (configurable via PORT env var).
# Coolify's healthcheck is pinned at localhost:8000, so default to 8000.
EXPOSE 8000

# Copy the start script (wraps the Deno server with Infisical secret injection)
COPY start-edge-functions.sh /app/start.sh
RUN chmod +x /app/start.sh

# Copy the server router (with CORS support) from the functions folder
RUN cp /app/functions/server.ts /app/server.ts

# Run the start script
CMD ["/app/start.sh"]

