# Supabase Edge Functions Dockerfile
# Runs Deno runtime for Supabase Edge Functions

FROM denoland/deno:1.38.5

# Install curl and wget for healthcheck (required by Coolify)
RUN apt-get update && apt-get install -y --no-install-recommends curl wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy edge functions
COPY supabase/functions ./functions

# Set environment variables (will be overridden by Coolify)
ENV SUPABASE_URL=""
ENV SUPABASE_ANON_KEY=""
ENV SUPABASE_SERVICE_ROLE_KEY=""

# Cache dependencies
RUN deno cache --reload functions/**/*.ts

# Expose port for Edge Functions (configurable via PORT env var, defaults to 3001)
EXPOSE 3001

# Create start script with process info
RUN echo '#!/bin/sh\n\
set -e\n\
echo "======================================"\n\
echo "Container ID: $(hostname)"\n\
echo "Process ID: $$"\n\
echo "Port: ${PORT:-3001}"\n\
echo "Starting Supabase Edge Functions Server..."\n\
echo "Available functions:"\n\
ls -la /app/functions/\n\
echo ""\n\
echo "Starting Deno server on port ${PORT:-3001}..."\n\
echo "======================================"\n\
exec deno run --allow-all /app/server.ts\n\
' > /app/start.sh && chmod +x /app/start.sh

# Copy the server router (with CORS support) from the functions folder
# This avoids escaping issues with the echo command
RUN cp /app/functions/server.ts /app/server.ts

# Run the start script
CMD ["/app/start.sh"]

