      "id": "section-3-note",
      "name": "Section 3: Content Gen",
      "type": "n8n-nodes-base.stickyNote",
      "position": [560, 1040],
      "typeVersion": 1
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.CLAUDE_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-haiku-20241022\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Refine this blog post title for maximum CTR:\\n\\nWorking Title: {{ $json.serp_data.article_goal ? $('Set Inputs').item.json.title : $('Set Inputs').item.json.title }}\\nPrimary Keyword: {{ $('Set Inputs').item.json.keywords }}\\nSearch Intent: {{ $json.serp_data.search_intent }}\\nTarget Audience: {{ $json.serp_data.target_audience }}\\nArticle Goal: {{ $json.serp_data.article_goal }}\\n\\nRequirements:\\n- 30-55 characters\\n- Include primary keyword naturally\\n- Action-driven, benefit-focused\\n- Industry-specific appeal for copier dealers\\n\\nOutput JSON only:\\n{\\n  \\\"revised_title\\\": \\\"string\\\",\\n  \\\"reasoning\\\": \\\"string\\\"\\n}\"\n    }\n  ],\n  \"system\": \"You are a B2B headline specialist for the office equipment industry. Create compelling titles that resonate with copier dealers and print service providers. Focus on ROI and efficiency gains, service optimization, operational challenges solved, competitive advantages. Output only valid JSON.\"\n}",
        "options": {}
      },
      "id": "title-refiner-claude",
      "name": "Title Refiner (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [600, 1160],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "new-title",
              "name": "new_title",
              "type": "string",
              "value": "={{ JSON.parse($json.content[0].text).revised_title }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-new-title",
      "name": "Set New Title",
      "type": "n8n-nodes-base.set",
      "position": [840, 1160],
      "typeVersion": 3.4
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.CLAUDE_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-haiku-20241022\",\n  \"max_tokens\": 2048,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Create Key Takeaways for:\\n\\nTitle: {{ $json.new_title }}\\nPrimary Keyword: {{ $('Set Inputs').item.json.keywords }}\\nSecondary Keywords: {{ JSON.stringify($('Merge Research Data').item.json.serp_data.keywords.secondary_keywords) }}\\nSearch Intent: {{ $('Merge Research Data').item.json.serp_data.search_intent }}\\nTarget Audience: {{ $('Merge Research Data').item.json.serp_data.target_audience }}\\nArticle Goal: {{ $('Merge Research Data').item.json.serp_data.article_goal }}\\nResearch: {{ $('Merge Research Data').item.json.research.substring(0, 4000) }}\"\n    }\n  ],\n  \"system\": \"You are a content strategist for B2B copier dealer content. Create 6-8 key takeaways that:\\n\\n1. Start with an intro paragraph (2-3 sentences)\\n2. Use bullet points with **bolded action headings**: Concise explanation\\n3. End with an outro paragraph leading into the main content\\n\\nFocus on:\\n- ROI and cost savings\\n- Time efficiency gains\\n- Service optimization\\n- Competitive advantages\\n- Practical implementation steps\\n\\nFormat in Markdown. No extra headers or dividers.\"\n}",
        "options": {}
      },
      "id": "key-takeaways-claude",
      "name": "Key Takeaways (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1080, 1160],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "takeaways",
              "name": "key_takeaways",
              "type": "string",
              "value": "={{ $json.content[0].text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-takeaways",
      "name": "Set Key Takeaways",
      "type": "n8n-nodes-base.set",
      "position": [1320, 1160],
      "typeVersion": 3.4
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.CLAUDE_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-haiku-20241022\",\n  \"max_tokens\": 2048,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate article outline for:\\n\\nTitle: {{ $('Set New Title').item.json.new_title }}\\nPrimary Keyword: {{ $('Set Inputs').item.json.keywords }}\\nKey Takeaways: {{ $json.key_takeaways.substring(0, 2000) }}\\nSecondary Keywords: {{ JSON.stringify($('Merge Research Data').item.json.serp_data.keywords.secondary_keywords) }}\\nSemantic Analysis: {{ JSON.stringify($('Merge Research Data').item.json.serp_data.semantic_analysis) }}\\nArticle Goal: {{ $('Merge Research Data').item.json.serp_data.article_goal }}\\n\\nCreate a detailed outline with:\\n- ## for main sections\\n- ### for subsections\\n- Brief descriptions for each section\\n- Natural keyword placement in headings\\n\\nDo NOT include Introduction or Conclusion - focus on body sections only.\"\n    }\n  ],\n  \"system\": \"You are a B2B content architect for the copier/print industry. Create logical, SEO-optimized outlines.\\n\\nStructure principles:\\n- Lead with value/benefit\\n- Progress from problem to solution\\n- Include practical implementation sections\\n- Add industry-specific examples\\n- Use secondary keywords in H2/H3 naturally\\n\\nOutput Markdown outline only.\"\n}",
        "options": {}
      },
      "id": "outline-claude",
      "name": "Outline (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1560, 1160],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "outline",
              "name": "post_outline",
              "type": "string",
              "value": "={{ $json.content[0].text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-outline",
      "name": "Set Outline",
      "type": "n8n-nodes-base.set",
      "position": [1800, 1160],
      "typeVersion": 3.4
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.CLAUDE_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
