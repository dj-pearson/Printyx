    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.PRINTYX_SUPABASE_URL }}/rest/v1/blog_content_queue",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $json.queue_id }}"
