            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"max_tokens\": 8192,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a comprehensive blog post:\\n\\nTitle: {{ $('Set New Title').item.json.new_title }}\\nPrimary Keyword: {{ $('Set Inputs').item.json.keywords }}\\nOutline: {{ $json.post_outline }}\\nKey Takeaways: {{ $('Set Key Takeaways').item.json.key_takeaways.substring(0, 2000) }}\\n\\nWriting Style: {{ $('Merge Research Data').item.json.serp_data.writing_style }}\\nWriting Tone: {{ $('Merge Research Data').item.json.serp_data.writing_tone }}\\nTarget Audience: {{ $('Merge Research Data').item.json.serp_data.target_audience }}\\nArticle Goal: {{ $('Merge Research Data').item.json.serp_data.article_goal }}\\n\\nSecondary Keywords: {{ JSON.stringify($('Merge Research Data').item.json.serp_data.keywords.secondary_keywords) }}\\nSemantic Keywords: {{ JSON.stringify($('Merge Research Data').item.json.serp_data.keywords.semantic_keywords) }}\\n\\nResearch Data:\\n{{ $('Merge Research Data').item.json.research.substring(0, 6000) }}\\n\\nRequirements:\\n- 2,500-3,500 words\\n- Introduction: 150-200 words, primary keyword in first 100 words\\n- Follow outline structure exactly\\n- 1-2% keyword density\\n- Include practical examples for copier dealers\\n- End with compelling CTA\\n- Markdown format\"\n    }\n  ],\n  \"system\": \"You are an expert B2B content writer for the copier/print industry. Write authoritative, practical content for copier dealers, print service providers, and office equipment businesses.\\n\\nWriting principles:\\n- Lead with value and ROI\\n- Use active voice\\n- Include specific metrics and examples\\n- Break complex concepts into actionable steps\\n- 3-4 sentence paragraphs max\\n- Use bullet points for lists\\n- Include relevant statistics\\n- Address industry-specific pain points\\n\\nNever use:\\n- Generic filler phrases\\n- Overly promotional language\\n- Jargon without explanation\\n- em dashes or semicolons\\n\\nFocus on practical solutions for:\\n- Service dispatch efficiency\\n- Meter billing automation\\n- Technician productivity\\n- Fleet management\\n- Customer retention\"\n}",
        "options": {
          "timeout": 120000
        }
      },
