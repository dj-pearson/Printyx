        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"status\": \"processing\",\n  \"started_at\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "mark-processing",
      "name": "Mark Processing",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1480, 240],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "content": "# 2. Research & SERP Analysis (Perplexity Direct API)",
        "height": 560,
        "width": 900,
        "color": 4
      },
      "id": "section-2-note",
      "name": "Section 2: Research",
      "type": "n8n-nodes-base.stickyNote",
      "position": [560, 440],
      "typeVersion": 1
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.perplexity.ai/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.PERPLEXITY_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"sonar-pro\",\n  \"web_search_options\": {\n    \"max_search_results\": 10\n  },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a professional B2B content strategist specializing in the copier/MFP dealer industry. Research topics deeply for print service providers, copier dealers, and office equipment businesses. Focus on operational efficiency, service management, fleet management, meter billing, and dealer growth strategies.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Research the following topic for a B2B copier dealer audience: '{{ $('Set Inputs').item.json.title }}'\\n\\nTarget Keywords: {{ $('Set Inputs').item.json.keywords }}\\n\\nProvide:\\n1. **Search Intent Analysis** - What are copier dealers/print service providers looking for?\\n2. **Content Gap** - What's missing from existing content?\\n3. **Key Subtopics & Questions** - Industry-specific questions to address\\n4. **Primary & Secondary Keywords** - Ranked by relevance to copier dealer industry\\n5. **Competitor Analysis** - Top 3 resources and their approach\\n6. **Data & Statistics** - Industry stats, ROI figures, efficiency metrics\\n7. **Audience Pain Points** - Specific challenges for copier dealers\\n8. **CTA Opportunities** - Where to drive demo requests/trials\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "perplexity-research",
      "name": "Perplexity Research",
      "type": "n8n-nodes-base.httpRequest",
      "position": [600, 560],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "research",
              "name": "research",
              "type": "string",
              "value": "={{ $json.choices[0].message.content.replaceAll(\"[1]\", \" - source: \" + ($json.citations?.[0] || '')).replaceAll(\"[2]\", \" - source: \" + ($json.citations?.[1] || '')).replaceAll(\"[3]\", \" - source: \" + ($json.citations?.[2] || '')).replaceAll(\"[4]\", \" - source: \" + ($json.citations?.[3] || '')).replaceAll(\"[5]\", \" - source: \" + ($json.citations?.[4] || '')) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "cleanup-citations",
      "name": "Cleanup Citations",
      "type": "n8n-nodes-base.set",
      "position": [840, 560],
      "typeVersion": 3.4
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an expert content strategist for B2B SaaS in the copier/print industry. Analyze search data and generate optimized writing guidelines.\\n\\nFocus on:\\n- Copier dealer operational challenges\\n- Print service provider efficiency\\n- Fleet management and MPS\\n- Meter billing automation\\n- Service dispatch optimization\\n- Technician productivity\\n\\nAlways output valid JSON with no extra text.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyze for: {{ $('Set Inputs').item.json.title }}\\nPrimary Keyword: {{ $('Set Inputs').item.json.keywords }}\\nTarget Audience: {{ $('Set Inputs').item.json.target_audience }}\\nIndustry: Copier dealers, MFP dealers, print service providers, office equipment\\n\\nResearch Data:\\n{{ $json.research.substring(0, 8000) }}\\n\\nOutput JSON only:\\n{\\n  \\\"search_intent\\\": \\\"informational|transactional|navigational|commercial\\\",\\n  \\\"writing_style\\\": \\\"string\\\",\\n  \\\"writing_tone\\\": \\\"string\\\",\\n  \\\"hidden_insight\\\": \\\"string\\\",\\n  \\\"target_audience\\\": \\\"string\\\",\\n  \\\"article_goal\\\": \\\"string\\\",\\n  \\\"semantic_analysis\\\": {\\n    \\\"common_subtopics\\\": [\\\"string\\\"],\\n    \\\"related_questions\\\": [\\\"string\\\"]\\n  },\\n  \\\"keywords\\\": {\\n    \\\"primary_keyword\\\": \\\"string\\\",\\n    \\\"secondary_keywords\\\": [\\\"string\\\"],\\n    \\\"semantic_keywords\\\": [\\\"string\\\"],\\n    \\\"long_tail_keywords\\\": [\\\"string\\\"]\\n  }\\n}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "serp-analysis-openai",
      "name": "SERP Analysis (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1080, 560],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "serp-data",
              "name": "serp_data",
              "type": "object",
              "value": "={{ JSON.parse($json.choices[0].message.content) }}"
            },
            {
              "id": "research",
              "name": "research",
              "type": "string",
              "value": "={{ $('Cleanup Citations').item.json.research }}"
            }
          ]
