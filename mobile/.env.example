# Printyx Mobile - Environment Variables
#
# Copy this file to .env and fill in the values.
# These are inlined at build time by Expo (EXPO_PUBLIC_ prefix required).
#
# For EAS builds, set these as secrets in Expo dashboard or eas.json.

# Supabase (same instance as web app)
EXPO_PUBLIC_SUPABASE_URL=https://api.printyx.net
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API Base URL (Edge Functions endpoint)
EXPO_PUBLIC_API_BASE_URL=https://functions.printyx.net

# App URL (for deep linking)
EXPO_PUBLIC_APP_URL=https://app.printyx.net
