# Fastfile - Printyx Mobile
#
# Used alongside EAS for store metadata management.
# EAS handles builds; Fastlane handles metadata upload.
#
# Usage:
#   fastlane ios metadata    # Upload iOS metadata to App Store Connect
#   fastlane android metadata # Upload Android metadata to Google Play
#

default_platform(:ios)

# ─── iOS ───────────────────────────────────────────────

platform :ios do
  desc "Upload metadata and screenshots to App Store Connect"
  lane :metadata do
    deliver(
      app_identifier: "com.printyx.app",
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      metadata_path: "./fastlane/metadata/ios",
      screenshots_path: "./screenshots/framed/ios",
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Upload screenshots only"
  lane :screenshots do
    deliver(
      app_identifier: "com.printyx.app",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      screenshots_path: "./screenshots/framed/ios",
      force: true,
    )
  end
end

# ─── Android ───────────────────────────────────────────

platform :android do
  desc "Upload metadata and screenshots to Google Play"
  lane :metadata do
    upload_to_play_store(
      package_name: "com.printyx.app",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      metadata_path: "./fastlane/metadata/android",
      track: "internal",
    )
  end

  desc "Upload screenshots only"
  lane :screenshots do
    upload_to_play_store(
      package_name: "com.printyx.app",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      metadata_path: "./fastlane/metadata/android",
    )
  end
end
