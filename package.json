{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "dev:frontend": "vite",
    "build": "vite build",
    "build:strict": "npm run validate && vite build",
    "build:fullstack": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "validate": "npm run validate:types && npm run validate:lint",
    "validate:types": "tsc --noEmit",
    "validate:lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "deploy": "echo 'Cloudflare Pages deployment in progress'",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "preview": "vite preview",
    "check": "tsc",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run server/tests/unit",
    "test:integration": "vitest run server/tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:all": "npm run test && npm run test:e2e",
    "test:comprehensive": "tsx tools/automated-testing/comprehensive-runner.ts",
    "test:discover": "tsx tools/automated-testing/comprehensive-discovery.ts",
    "test:execute": "tsx tools/automated-testing/comprehensive-execution.ts",
    "check:secrets": "tsx tools/automated-testing/check-no-secrets.ts",
    "db:push": "drizzle-kit push",
    "db:push:forecast": "drizzle-kit push --config=drizzle.forecasting.config.ts",
    "updater": "tsx server/database-updater/cli/updater-cli.ts",
    "updater:start": "tsx server/database-updater/cli/updater-cli.ts start",
    "updater:status": "tsx server/database-updater/cli/updater-cli.ts status",
    "updater:test": "tsx server/database-updater/cli/updater-cli.ts test",
    "example": "tsx server/database-updater/examples/basic-usage.ts",
    "kb": "tsx server/cli/kb-cli.ts",
    "kb:list": "tsx server/cli/kb-cli.ts list",
    "kb:stats": "tsx server/cli/kb-cli.ts stats",
    "kb:create": "tsx server/cli/kb-cli.ts create",
    "kb:import": "tsx server/cli/kb-cli.ts import",
    "kb:export": "tsx server/cli/kb-cli.ts export",
    "seed:rbac": "tsx server/database-updater/seeders/rbac-seeder.ts",
    "seed:reports": "tsx server/database-updater/seeders/report-seeder.ts",
    "seed:kpis": "tsx server/database-updater/seeders/kpi-seeder.ts",
    "seed:plans": "tsx server/seed-subscription-plans.ts",
    "stripe:setup": "tsx scripts/setup-stripe-products.ts",
    "stripe:setup:live": "tsx scripts/setup-stripe-products.ts --live",
    "stripe:setup:dry-run": "tsx scripts/setup-stripe-products.ts --dry-run",
    "stripe:update-db": "tsx server/update-stripe-ids.ts",
    "migrate:analyze": "tsx scripts/migrate-business-records-to-companies.ts analyze",
    "migrate:preview": "tsx scripts/migrate-business-records-to-companies.ts preview",
    "migrate:execute": "tsx scripts/migrate-business-records-to-companies.ts execute",
    "fix:contacts": "tsx scripts/fix-missing-contacts.ts",
    "lint:transformations": "tsx tools/data-transformation-linter.ts",
    "fix:transformations": "tsx tools/data-transformation-fixer.ts",
    "fix:transformations:dry-run": "tsx tools/data-transformation-fixer.ts --dry-run",
    "check:system": "tsx scripts/comprehensive-system-check.ts",
    "check:schema": "tsx scripts/database-schema-reporter.ts"
