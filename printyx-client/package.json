{
  "name": "printyx-client",
  "version": "1.0.0",
  "description": "Lightweight monitoring client for Printyx toner level tracking",
  "main": "dist/index.js",
  "bin": {
    "printyx-client": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "node esbuild.config.mjs",
    "build:exe": "node build-exe.mjs",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "printyx",
    "monitoring",
    "printer",
    "toner",
    "snmp"
  ],
  "author": "Printyx",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bonjour-service": "^1.2.1",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "ip-range-check": "^0.2.0",
    "net-snmp": "^3.11.2",
    "node-cron": "^3.0.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/net-snmp": "^3.5.5",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.56.0",
    "postject": "^1.0.0-alpha.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
