{
  "manifest_version": 3,
  "name": "Printyx CRM - LinkedIn Lead Importer",
  "version": "1.0.0",
  "description": "Import LinkedIn profiles directly to your Printyx CRM with one click. Automatically enriches contacts with email, phone, and company data.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://*.printyx.net/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": [
        "lib/linkedin-parser.js",
        "content-scripts/linkedin-injector.js"
      ],
      "css": [
        "content-scripts/injector.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*.png"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ]
    }
  ]
}
