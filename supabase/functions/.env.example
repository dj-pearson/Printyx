# Supabase Edge Functions Environment Variables
# Copy this file to .env and update with your values

# ===========================================
# Required Variables
# ===========================================

# Supabase Project URL
SUPABASE_URL=https://api.printyx.net

# Supabase Anonymous Key (public)
SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===========================================
# Optional Variables
# ===========================================

# CORS Allowed Origins (comma-separated)
# If not set, defaults to: https://printyx.net,https://www.printyx.net,http://localhost:5173,http://localhost:5000
# Example: ALLOWED_ORIGINS=https://printyx.net,https://www.printyx.net,https://staging.printyx.net
ALLOWED_ORIGINS=https://printyx.net,https://www.printyx.net

# Server Port (default: 3001)
PORT=3001

# Site URL (used for email links, redirects)
SITE_URL=https://printyx.net

# ===========================================
# Development Overrides
# ===========================================

# For local development, uncomment:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://localhost:3000
# SITE_URL=http://localhost:5173
